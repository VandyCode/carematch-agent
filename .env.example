# Copy to .env and configure for your environment. Never commit .env!

# Optional: Gemini API key for live LLM synthesis (deterministic CMS fallback runs even without a key)
GEMINI_API_KEY=your-gemini-api-key-here

# Model identifier (public Gemini API / Vertex AI model name)
CAREMATCH_MODEL=gemini-2.5-flash

# Optional: Enable live HTTP lookups against public CMS Provider Data & NPPES NPI APIs
CAREMATCH_CMS_LIVE_API=false

# Local SQLite database path for conversation memory, care shortlist notes, and user feedback
CAREMATCH_MEMORY_DB=carematch_memory.db

# Optional: Google Cloud deployment metadata
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=false

# CORS allowed origins (comma-separated)
ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
